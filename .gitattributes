# Preserve original asset and legacy document handling.
*.uasset binary
*.umap binary
*.pdf binary
*.pptx binary
*.zip binary
*.md text eol=lf
*.txt text eol=lf

# Manifest verification requires identical payload bytes on every platform.
/.gitattributes -text
/bundle.json -text
/README.md -text
/README.ko.md -text
/docs/** -text
/downloads/** -text
/overlay/** -text
/manifests/** -text
/evidence/** -text
/figures/** -text
/inspections/** -text
/reports/** -text
/tools/** -text
/tests/** -text
